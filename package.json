{
  "name": "@rohaquinlop/pi-deepseek-cache",
  "version": "0.6.0",
  "description": "Prefix cache optimization for pi — DeepSeek and Xiaomi MiMo. Date/CWD freeze, hit-rate telemetry, cache-friendly compaction, and TUI overlays",
  "keywords": ["pi-package", "deepseek", "mimo", "cache", "prefix-cache", "coding-agent", "extension"],
  "license": "MIT",
  "author": "rohaquinlop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohaquinlop/pi-deepseek-cache.git"
  },
  "files": ["extensions/", "lib/", "README.md"],
  "pi": {
    "extensions": ["./extensions/index.ts"],
    "appliesToModels": [
      "deepseek-*",
      "deepseek",
      "*/deepseek-*",
      "mimo-*",
      "*/mimo-*",
      "xiaomi",
      "xiaomi-token-plan-ams",
      "xiaomi-token-plan-cn",
      "xiaomi-token-plan-sgp"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
